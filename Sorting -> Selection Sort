def SelectionSort(L):
    n = len(L)
    # Case 1: When list contains 1 or none element.
    if n <= 1:
        return L
    # Case 2: In each iteration find smallest element and place it in right position.
    for i in range(n):
        minpos = i
        for j in range(i+1,n):
            if L[minpos] > L[j]:
                minpos = j
        L[i], L[minpos] = L[minpos], L[i]
    return L

# Time complexity : O(n^2)
# Space complexity : O(1)
# Stable : No
