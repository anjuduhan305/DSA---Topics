def bubble_sort(arr):
    n = len(arr)
    swaps = 0

    for i in range(n):
        swapped = False
        
        for j in range(n - 1 - i):
            if arr[j] > arr[j + 1]:
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
                swaps += 1
                swapped = True

        # If swap = False in one pass,
        # then, we can say that array is already sorted.
        if not swapped:
            break

    print("Total swaps:", swaps)
    return arr

# Time complexity : O(n^2)
# Space complexity : O(1)
# Stable : Yes
