'''
    implementing stack class:
    Data members: stack[] - list of integers
    Functions: constructor __init__(), isempty(), push(), pop(), __str__(), peek(), size()
'''
class Stack:
    def __init__(self):
        self.stack = []

    def isempty(self):
        return self.stack == []

    def push(self,v):
        self.stack.append(v)

    def pop(self):
        v = None
        if not self.isempty():
            v = self.stack.pop()
        return v

    def __str__(self):
        return str(self.stack)

    def peek(self):
        if not self.isempty():
            return self.stack[-1]
        return None

    def size(self):
        return len(self.stack)
