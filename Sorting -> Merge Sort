# Let's implement merge function that merges two sorted lists A and B.
def Merge(A, B):
    m, n = len(A), len(B)
    C, i ,j = [], 0, 0
    # When both lists A and B have element for comparing.
    while i < m and j < n:
        if A[i] <= B[j]:
            C.append(A[i])
            i += 1
        else:
            C.append(B[j])
            j += 1

    # If list B is over, shift all elements of A to C.
    while i < m:
        C.append(A[i])
        i += 1

    # If list A is over, shift all elements of B to C.
    while j < n:
        C.append(B[j])
        j += 1

    # Return sorted merge list.
    return C

# Let's implement merge sort function that divide the problem into sub-problems ie., sub-lists.
def MergeSort(L):
    n = len(L)

    # Base Case: If the list have one or none element.
    if n <= 1:
        return L
    
    # Recursively call merge sort the left half of the list.
    left = MergeSort(L[:n//2])

    # Recursively call merge sort the right half of the list.
    right = MergeSort(L[n//2:])

    # Merge two sorted list Left_Half and Right_Half.
    sorted_list = Merge(left, right)
    return sorted_list

# Time complexity : O(n logn)
# Space complexity : O(n)
# Stable : Yes
