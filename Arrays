class MyArray:
    def __init__(self, capacity=10):
        self.capacity = capacity          
        self.size = 0                     
        self.data = [None] * capacity     

    # ---------- Helper ----------
    def is_empty(self):
        return self.size == 0

    def is_full(self):
        return self.size == self.capacity

    def __len__(self):
        return self.size

    def __str__(self):
        return str(self.data[:self.size])


    # ---------- 1. Traversal ----------  O(n)
    def display(self):
        if self.is_empty():
            print("Array khali hai")
            return
        for i in range(self.size):
            print(self.data[i], end=" ")
        print()


    # ---------- 2. Access ----------  O(1)
    def get(self, index):
        if index < 0 or index >= self.size:
            raise IndexError("Index out of range")
        return self.data[index]


    # ---------- 3. Update ----------  O(1)
    def update(self, index, value):
        if index < 0 or index >= self.size:
            raise IndexError("Index out of range")
        self.data[index] = value


    # ---------- 4. Insert at end ----------  O(1)
    def append(self, value):
        if self.is_full():
            self._resize()
        self.data[self.size] = value
        self.size += 1


    # ---------- 5. Insert at position ----------  O(n)
    def insert(self, index, value):
        if index < 0 or index > self.size:
            raise IndexError("Invalid index")
        if self.is_full():
            self._resize()
        # right shift
        for i in range(self.size, index, -1):
            self.data[i] = self.data[i - 1]
        self.data[index] = value
        self.size += 1


    # ---------- 6. Delete by position ----------  O(n)
    def delete(self, index):
        if self.is_empty():
            raise Exception("Array khali hai")
        if index < 0 or index >= self.size:
            raise IndexError("Invalid index")
        removed = self.data[index]
        # left shift
        for i in range(index, self.size - 1):
            self.data[i] = self.data[i + 1]
        self.data[self.size - 1] = None
        self.size -= 1
        return removed


    # ---------- 7. Delete by value ----------  O(n)
    def remove(self, value):
        idx = self.linear_search(value)
        if idx == -1:
            print("Value nahi mili")
            return None
        return self.delete(idx)


    # ---------- 8. Reverse ----------  O(n)
    def reverse(self):
        i, j = 0, self.size - 1
        while i < j:
            self.data[i], self.data[j] = self.data[j], self.data[i]
            i += 1
            j -= 1


    # ---------- 9. Min / Max / Sum ----------  O(n)
    def minimum(self):
        if self.is_empty():
            return None
        m = self.data[0]
        for i in range(1, self.size):
            if self.data[i] < m:
                m = self.data[i]
        return m

    def maximum(self):
        if self.is_empty():
            return None
        m = self.data[0]
        for i in range(1, self.size):
            if self.data[i] > m:
                m = self.data[i]
        return m

    def total(self):
        s = 0
        for i in range(self.size):
            s += self.data[i]
        return s


    # ---------- 10. Internal: capacity double karna ----------  O(n)
    def _resize(self):
        self.capacity *= 2
        new_data = [None] * self.capacity
        for i in range(self.size):
            new_data[i] = self.data[i]
        self.data = new_data
