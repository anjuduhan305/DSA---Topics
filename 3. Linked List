'''
    Implementing Node class:
    Data members : data and next
    Functions : constructor __init__()
'''
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

'''
    Implementing LinkedList class:
    Data members : head
    Functions : constructor __init__(), isempty(), append(), delete(), display()
'''
class LinkedList:
    def __init__(self):
        self.head = None

    # func 2 -> isempty()
    def isempty(self):
        return self.head == None

    # func 3 -> append()
    def append(self, data):
        if self.isempty():
            self.head = Node(data)
        else:
            current = self.head
            while current.next is not None:
                current = current.next
            current.next = Node(data)

    # func 4 -> delete()
    def delete(self, v):
        # case 1: List is empty.
        if self.isempty():
            return 'List is empty'
        
        # case 2: If element v is found in the head itself.
        if self.head.data == v:
            self.head = self.head.next
            return
        
        # case 3: If element v is found somewhere in linked list.
        current = self.head
        while current.next.next is not None and current.next.data != v:
            current = current.next
        current.next = current.next.next 
        if current.next != None:
            return

        # case 4: If the element v does not exist.
        if current.next == None:
            return 'Not exist'

    # func 5 -> display()
    def display(self):
        current = self.head
        while current is not None:
            print(current.data, end=',')
            current = current.next
        print('Stop')
