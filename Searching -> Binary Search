# Pre-codition : Input list L must be sorted.
# Return: Index of element, if element found in list L otherwise False.
def binarysearch(L,v):
    low = 0
    high = len(L)-1
    while low <= high:
        mid = (low+high) // 2
        if L[mid] < v:
            low = mid+1
        elif L[mid] > v:
            high = mid-1
        else:
            return mid # When the element v is found in list L.
    return False # When the element v is not found in list L.
